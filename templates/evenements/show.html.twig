{% extends 'base.html.twig' %}

{% block title %}{{ actualite.titre }}{% endblock %}
{% block stylesheets %}       
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/news.css') }}">
    <link rel="stylesheet" href="{{ asset('css/produit.css') }}">
 {% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="text-center mb-3">{{ actualite.titre }}</h1>

        <div class="actualite-detail">
            {# Image de l'événement #}
            {% if actualite.image %}
                <img src="{{ asset('/uploads/actualite/' ~ actualite.image) }}" alt="{{ actualite.titre }}" class="news-image">
            {% endif %}

            <p><strong>Date :</strong> {{ actualite.date|date('d/m/Y H:i') }}</p>
            <p>{{ actualite.description|raw }}</p>
        </div>

        <hr>

        <h2>Reservez maintenant ! </h2><br>
        <div class="produits-lies" style="display:flex; flex-wrap:wrap; gap:20px;">
            {% for produit in actualite.produits %}
                <div class="produit-card text-center">
                    {% if produit.image %}
                        <img src="{{ asset('/uploads/produits/' ~ produit.image) }}" alt="{{ produit.titre }}">
                    {% endif %}
                    <h3>{{ produit.titre }}</h3>
                    <p>{{ produit.description|length > 80 ? produit.description[:80] ~ '...' : produit.description }}</p>
                    <p><strong>Prix :</strong> {{ produit.prixUnitaire }} €</p>

                    <form method="post" action="{{ path('panier_ajouter', {id: produit.id}) }}">
                        <input type="hidden" name="quantite" value="1">

                        <button type="submit" class="btn-acheter">
                            🛒 Mettre au panier
                        </button>
                    </form>
                </div>
            {% else %}
                <p>Aucun produit associé pour cet événement.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}