{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de ma commande{% endblock %}

{% block body %}

<div class="container my-5">

    <h1 class="text-center mb-5">
        Récapitulatif de votre commande
    </h1>

    <div class="row">

        <div class="col-lg-8">

            <div class="card mb-4">

                <div class="card-body">

                    <h3 class="mb-4">
                        Votre commande
                    </h3>

                    {% for ligne in commande.ligneCommandes %}

                        <div class="d-flex justify-content-between align-items-center border-bottom py-3">

                            <div>

                                <strong>
                                    {{ ligne.produit.titre }}
                                </strong>

                                <div class="text-muted">
                                    {{ ligne.quantite }}
                                    ×
                                    {{ ligne.prixUnitaire|number_format(2, ',', ' ') }}
                                    €
                                </div>

                            </div>

                            <strong>
                                {{
                                    (ligne.prixUnitaire * ligne.quantite)
                                    |number_format(2, ',', ' ')
                                }} €
                            </strong>

                        </div>

                    {% endfor %}

                    <div class="d-flex justify-content-between mt-4">

                        <strong class="fs-4">
                            Total
                        </strong>

                        <strong class="fs-4">
                            {{ commande.total|number_format(2, ',', ' ') }} €
                        </strong>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card">

                <div class="card-body">

                    <h4>Vos informations</h4>

                    <hr>

                    <p>
                        <strong>
                            {{ commande.prenom }} {{ commande.nom }}
                        </strong>
                    </p>

                    <p>
                        📧 {{ commande.email }}
                    </p>

                    {% if commande.telephone %}
                        <p>
                            📞 {{ commande.telephone }}
                        </p>
                    {% endif %}

                    <hr>

                    <p class="text-muted mb-1">
                        N° de commande
                    </p>

                    <strong>
                        {{ commande.numeroCommande }}
                    </strong>

                    <div class="alert alert-success text-center mt-4">
                        <h4 class="alert-heading">✅ Réservation enregistrée !</h4>

                        <p class="mb-2">
                            Votre réservation a bien été prise en compte.
                        </p>

                        <p class="mb-0">
                            <strong>Le paiement sera effectué ultérieurement.</strong><br>
                            Les modalités de paiement vous seront communiquées prochainement.
                        </p>
                    </div>

                    <div class="text-center mt-4">
                        <a href="{{ path('products') }}" class="btn btn-primary">
                            ← Retour aux réservations
                        </a>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}