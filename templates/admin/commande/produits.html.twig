{% set lignes = entity.instance.ligneCommandes %}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-light">
            <tr>
                <th>Produit</th>
                <th class="text-center">Quantité</th>
                <th class="text-end">Prix unitaire</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>

        <tbody>

        {% for ligne in lignes %}

            <tr>
                <td>
                    <strong>{{ ligne.produit.titre }}</strong>
                </td>

                <td class="text-center">
                    {{ ligne.quantite }}
                </td>

                <td class="text-end">
                    {{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €
                </td>

                <td class="text-end">
                    {{ (ligne.prixUnitaire * ligne.quantite)|number_format(2, ',', ' ') }} €
                </td>
            </tr>

        {% else %}

            <tr>
                <td colspan="4" class="text-center text-muted">
                    Aucun produit réservé.
                </td>
            </tr>

        {% endfor %}

        </tbody>

        <tfoot>
            <tr>
                <th colspan="3" class="text-end">
                    TOTAL
                </th>

                <th class="text-end">
                    {{ entity.instance.total|number_format(2, ',', ' ') }} €
                </th>
            </tr>
        </tfoot>

    </table>
</div>