{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}

<div class="container my-5">

    <h1 class="mb-4 text-center">🛒 Mon panier</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% if panier is empty %}

        <div class="text-center py-5">

            <h3>Votre panier est vide</h3>

            <p class="text-muted">
                Vous n'avez encore ajouté aucun produit.
            </p>

            <a href="{{ path('products') }}" class="btn btn-primary">
                Voir les produits
            </a>

        </div>

    {% else %}

        <div class="row">

            <div class="col-lg-8">

                {% for item in panier %}

                    <div class="card mb-3">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <div class="col-md-2">

                                    {% if item.produit.image %}
                                        <img
                                            src="{{ asset('/uploads/produits/' ~ item.produit.image) }}"
                                            alt="{{ item.produit.titre }}"
                                            class="img-fluid"
                                        >
                                    {% endif %}

                                </div>

                                <div class="col-md-4">

                                    <h5>
                                        {{ item.produit.titre }}
                                    </h5>

                                    <p class="text-muted mb-0">
                                        {{ item.produit.prixUnitaire }} €
                                    </p>

                                </div>

                                <div class="col-md-3">

                                    <form
                                        method="post"
                                        action="{{ path('panier_modifier', {id: item.produit.id}) }}"
                                        class="d-flex"
                                    >

                                        <input
                                            type="number"
                                            name="quantite"
                                            value="{{ item.quantite }}"
                                            min="1"
                                            class="form-control"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-secondary ms-2"
                                        >
                                            OK
                                        </button>

                                    </form>

                                </div>

                                <div class="col-md-2 text-end">

                                    <strong>
                                        {{ item.total|number_format(2, ',', ' ') }} €
                                    </strong>

                                </div>

                                <div class="col-md-1 text-end">

                                    <form
                                        method="post"
                                        action="{{ path('panier_supprimer', {id: item.produit.id}) }}"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-danger"
                                        >
                                            ×
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                {% endfor %}

            </div>

            <div class="col-lg-4">

                <div class="card">

                    <div class="card-body">

                        <h4>Récapitulatif</h4>

                        <hr>

                        <div class="d-flex justify-content-between">
                            <span>Articles</span>
                            <span>{{ nombreArticles }}</span>
                        </div>

                        <div class="d-flex justify-content-between mt-2">
                            <strong>Total</strong>
                            <strong>
                                {{ total|number_format(2, ',', ' ') }} €
                            </strong>
                        </div>

                        <hr>

                        <a href="{{ path('checkout') }}" class="btn btn-success w-100">
                            Passer la commande
                        </a>

                        <a
                            href="{{ path('products') }}"
                            class="btn btn-outline-primary w-100 mt-2"
                        >
                            Continuer mes achats
                        </a>

                        <form
                            method="post"
                            action="{{ path('panier_vider') }}"
                            class="mt-2"
                        >

                            <button
                                type="submit"
                                class="btn btn-outline-danger w-100"
                            >
                                Vider le panier
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}