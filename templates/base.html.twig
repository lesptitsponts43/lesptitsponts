<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Association Les Petits Ponts{% endblock %}</title>

    {# Bootstrap CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tarteaucitronjs@1.12.0/tarteaucitron.js"></script>
    <script src="{{ asset('js/tarteaucitron.js') }}"></script>

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">
        <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">

    {# Menu #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
           <a class="navbar-brand color-vert"  href="{{ path('home') }}">
                Les Petits Ponts
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

    <li class="nav-item">
        <a class="nav-link {% if app.request.attributes.get('_route') == 'home' %}active{% endif %}"
           href="{{ path('home') }}">
            Accueil
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link {% if app.request.attributes.get('_route') == 'contact' %}active{% endif %}"
           href="{{ path('contact') }}">
            Contact
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link {% if app.request.attributes.get('_route') == 'news' %}active{% endif %}"
           href="{{ path('news') }}">
            Évènement
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link {% if app.request.attributes.get('_route') == 'products' %}active{% endif %}"
           href="{{ path('products') }}">
            Produits
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link position-relative {% if app.request.attributes.get('_route') == 'order' %}active{% endif %}"
           href="{{ path('order') }}">

            🛒 Panier

            {% if nombreArticlesPanier > 0 %}
                <span class="badge rounded-pill bg-success panier-badge">
                    {{ nombreArticlesPanier }}
                </span>
            {% endif %}

        </a>
    </li>

</ul>
            </div>
        </div>
    </nav>
    <div class="text-center" style="max-height:200px;">
    <div class="text-center logo-container">
    <img src="{{ asset('charte/logo.png') }}"
         alt="Les Petits Ponts"
         class="logo">
</div>
    </div>

    {# Contenu principal flexible #}
    <main class="flex-grow-1">
        {% block body %}{% endblock %}
    </main>


    {{ render(controller('App\\Controller\\PartnerController::partners')) }}


    {# Footer #}
    <footer class="bg-primary text-white mt-auto">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <h5 class="color-vert">Association Les Petits Ponts</h5>
                    <p>Nous organisons des tournois et activités pour les enfants de 6-7 ans, afin de partager les valeurs du sport et créer des souvenirs inoubliables.</p>
                    <a href="{{ path('mentions') }}">Mentions Légales</a>
                </div>
                <div class="col-md-6 text-md-start">
                    <h5 class="color-vert">Contact</h5>
                    <p>📧 Email : <a href="mailto:lesptitsponts43@gmail.com" class="color-vert">lesptitsponts43@gmail.com</a></p>
                    <p>📞 Téléphone :<span class="color-vert"> 07-54-55-09-49 ou 06-37-08-00-14</span></p>
                    <p>&copy; 2026 Association <span class="color-vert">Les Petits Ponts</span></p>
                </div>
            </div>
        </div>
    </footer>

    {# Bootstrap JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
